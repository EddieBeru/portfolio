  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M14 10v16a10 10 0 0 0 20 0V10" />
  <path d="M14 34h20" stroke-opacity="0.4" />
  <circle cx="24" cy="20" r="2.5" fill="currentColor" stroke="none" />
</svg>
