---
interface Props {
  size?: number;
}
const { size = 48 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <path d="M7 38h34" stroke-opacity="0.4" />
  <path d="M8 33c6 0 9-10 16-13s12-6 16-8" />
  <circle cx="24" cy="20" r="3" fill="currentColor" stroke="none" />
</svg>
